      "notesInFlow": true,
      "notes": "Ruft /api/v2/experiments_templates/{templateId} ab"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nlet tpl = res.body || res;\n\nif (tpl && typeof tpl.metadata === 'string') {\n  try {\n    tpl.metadata = JSON.parse(tpl.metadata);\n  } catch (e) {\n    tpl.metadata = {};\n  }\n}\n\nreturn {\n  json: {\n    status: 'success',\n    server_time: new Date().toISOString(),\n    template: tpl\n  }\n};"
      },
